{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "diagnose:s3-put": "node dist/scripts/diagnose-s3-put.js",
    "verify:auth": "tsc -p tsconfig.json && node dist/scripts/verify-auth.js",
    "verify:phase2": "tsc -p tsconfig.json && node dist/scripts/verify-phase2.js",
    "verify:phase3": "tsc -p tsconfig.json && node dist/scripts/verify-phase3.js",
    "verify:phase4": "tsc -p tsconfig.json && node dist/scripts/verify-phase4.js",
    "verify:phase5": "tsc -p tsconfig.json && node dist/scripts/verify-phase5.js",
    "verify:phase6": "tsc -p tsconfig.json && node dist/scripts/verify-phase6.js",
    "verify:phase7": "tsc -p tsconfig.json && node dist/scripts/verify-phase7.js",
    "verify:phase8": "tsc -p tsconfig.json && node dist/scripts/verify-phase8.js",
    "verify:phase9": "tsc -p tsconfig.json && node dist/scripts/verify-phase9.js",
    "verify:phase10": "tsc -p tsconfig.json && node dist/scripts/verify-phase10.js",
    "verify:phase12": "tsc -p tsconfig.json && node dist/scripts/verify-phase12.js",
    "verify:phase15": "tsc -p tsconfig.json && node dist/scripts/verify-phase15.js",
    "verify:civic-work-registry": "tsc -p tsconfig.json && node dist/scripts/verify-civic-work-registry.js",
    "verify:demo100": "tsc -p tsconfig.json && node dist/scripts/verify-demo100.js",
    "verify:coordination": "tsc -p tsconfig.json && node dist/scripts/verify-coordination.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1120.0",
    "@aws-sdk/s3-request-presigner": "3.1120.0",
    "@civicos/shared": "workspace:*",
    "@huggingface/transformers": "3.8.1",
    "bcrypt": "6.0.0",
    "compression": "1.8.1",
    "cors": "2.8.5",
    "db": "workspace:*",
    "dotenv": "16.6.1",
    "express": "4.21.2",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@civicos/config": "workspace:*",
    "@types/bcrypt": "5.0.2",
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.3.0",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
