{
  "expo": {
    "name": "City Connect",
    "slug": "city-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "newArchEnabled": true,
    "scheme": "cityconnect",
    "ios": {
      "bundleIdentifier": "com.cityconnect.mobile",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "com.cityconnect.mobile",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "City Connect uses your photos as evidence for civic reports.",
          "cameraPermission": "City Connect uses your camera to photograph civic issues.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "City Connect uses your location to route civic reports to the right ward."
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "836f9ba9-34a3-4ca7-8742-eb33d4923f6f"
      }
    }
  }
}
