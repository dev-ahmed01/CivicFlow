# Pothole AI Service Configuration
PORT=8000
HOST=0.0.0.0
ENV=development

# Runtime Mode: "real" or "demo"
# "real": Requires actual trained YOLO weights file. Fails startup/health if missing.
# "demo": Permits synthetic deterministic detector for offline demo/testing.
POTHOLE_AI_MODE=real

# Internal Server-to-Server Authentication Token (Passed in X-Internal-Token header)
POTHOLE_AI_INTERNAL_TOKEN=dev-secret-token-civicflow
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Model Settings
MODEL_PATH=weights/yolov8n-seg-pothole.pt
CONFIDENCE_THRESHOLD=0.25
DEVICE=cpu # cpu, cuda, or auto

# Input Hardening & Limits
MAX_UPLOAD_BYTES=10485760 # 10MB
MAX_IMAGE_DIMENSION=1920

# Frame Quality Thresholds
MIN_BLUR_SCORE=50.0
MIN_BRIGHTNESS=0.15
MAX_BRIGHTNESS=0.90

# Temporal Confirmation Settings
TEMPORAL_IOU_THRESHOLD=0.30
TEMPORAL_TIME_WINDOW_SEC=30.0
TEMPORAL_MIN_REPEAT_FRAMES=3

# Verification Scan Settings
VERIFICATION_ROI_IOU_THRESHOLD=0.30
VERIFICATION_MIN_CONFIDENCE=0.30
VERIFICATION_MIN_USABLE_FRAMES=3
