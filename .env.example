DATABASE_URL="postgresql://civicos:civicos@localhost:5433/civicos?schema=public"
DEPLOYMENT_PROFILE="local"
PORT=4000
JWT_ACCESS_SECRET="replace-with-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-different-32-character-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
# Required by the production seed hook; never use the local default in deployment.
# DEMO_INTERNAL_PASSWORD="replace-with-a-strong-rehearsal-password"
OTP_PROVIDER="console"
OTP_TTL_MINUTES=10
# Free demo only: set all three together. Production rejects these values.
DEMO_AUTH_MODE="disabled"
# DEMO_AUTH_CODE="123456"
# Local verification only. Omit this to generate random OTPs.
OTP_MOCK_CODE="123456"
# Production OTP delivery (required when NODE_ENV=production).
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="replace-me"
# TWILIO_FROM_NUMBER="+12025550123"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="civicos-images"
S3_ACCESS_KEY_ID="civicos-local"
S3_SECRET_ACCESS_KEY="civicos-local-secret"
S3_PUBLIC_BASE_URL="http://localhost:9000/civicos-images"
# Required in production. Development uses an explicitly marked deterministic adapter.
# CLIP_MODE="auto"
# CLIP_INFERENCE_URL="https://inference.example.com/clip"
# CLIP_INFERENCE_TOKEN="replace-me"
# Comma-separated deployed web origins; required in production.
# CORS_ORIGINS="https://civicos.example.com,https://civicos-web.vercel.app"
# Protects POST /internal/jobs/validation-rebatch when an external scheduler is used.
# CRON_SECRET="replace-with-at-least-32-characters"
VALIDATION_REBATCH_POLL_MINUTES=15
DEPENDENCY_ESCALATION_POLL_MINUTES=15
DEADLINE_ESCALATION_POLL_MINUTES=15
DEMO_NOTIFY_ALL_CITIZENS=false
PUSH_DELIVERY_POLL_SECONDS=15
# Optional for Expo projects using push access-token security.
EXPO_ACCESS_TOKEN=

# Frontend build-time configuration. Deployed builds must not use localhost.
NEXT_PUBLIC_API_URL="http://localhost:4000"
EXPO_PUBLIC_API_URL="http://10.0.2.2:4000"
# EAS project UUID, injected while resolving apps/mobile/app.config.ts.
# EAS_PROJECT_ID="00000000-0000-4000-8000-000000000000"
