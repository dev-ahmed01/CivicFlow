generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  CITIZEN
  PROJECT_HEAD
  ENGINEER
}

enum TicketState {
  DRAFT
  AI_CHECK_PENDING
  AI_FLAGGED
  PENDING_VALIDATION
  VALIDATED
  ROUTED_TO_AGENCY
  INSPECTION_DUE
  INSPECTION_COMPLETE
  PROJECT_CREATED
  ENGINEER_ASSIGNED
  WORK_IN_PROGRESS
  WORK_COMPLETED
  AWAITING_CITIZEN_VERIFICATION
  RESOLVED
  CLOSED
  REJECTED
  CANCELLED
}

enum Channel {
  WEB
  MOBILE
}

enum ProjectState {
  CREATED
  PENDING_UPTAKE
  UPTAKEN
  TIMELINE_SET
  CONFLICT_CHECKED
  READY_TO_START
  ACTIVE
  MODIFIED
  COMPLETED
  AWAITING_VERIFICATION
  CLOSED
  CANCELLED
}

enum CivicWorkOrigin {
  AGENCY_PLANNED
  CITIZEN_REPORTED
  SYSTEM_INTEGRATION
}

enum CivicWorkPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ProjectEvidenceKind {
  PLANNING_DOCUMENT
  SITE_PHOTO
  PERMIT
  INSPECTION
  OTHER
}

enum InspectionStatus {
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  SUBMITTED
  REVIEWED
}

enum InspectionIssueConfirmation {
  CONFIRMED
  PARTIALLY_CONFIRMED
  NOT_OBSERVED
}

enum InspectionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InspectionComplexity {
  LOW
  MEDIUM
  HIGH
}

enum InspectionRecommendation {
  PROCEED
  COORDINATION_REQUIRED
  ADDITIONAL_INVESTIGATION
  NO_WORK_REQUIRED
}

enum InspectionReviewDecision {
  CREATE_WORK
  ADDITIONAL_INSPECTION
  NO_WORK_REQUIRED
}

enum ConflictSeverity {
  PROMINENT
  INLINE
}

enum RoadConflictType {
  SPATIAL
  TEMPORAL
  SEQUENCING_VIOLATION
  RESTORATION_TOO_EARLY
  REPEATED_EXCAVATION_RISK
  DUPLICATE_INTERVENTION
}

enum RoadConflictSeverity {
  HIGH
  MEDIUM_HIGH
  MEDIUM
}

enum SequencingRecommendationOutcome {
  ACCEPTED
  MODIFIED
  DISMISSED
}

enum CompletionVerificationDecision {
  VERIFIED
  REWORK_REQUESTED
}

enum DependencyState {
  REQUESTED
  PENDING_RESPONSE
  ASSIGNED
  DECLINED_UNAVAILABLE
  DECLINED_NOT_CONCERNED
  ESCALATED
  FULFILLED
}

enum CoordinationStatus {
  DRAFT
  SENT
  ACKNOWLEDGED
  CLARIFICATION_REQUESTED
  INSPECTION_REQUIRED
  ENGINEER_ASSIGNED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CLOSED
  REJECTED
}

enum ValidationVote {
  CONFIRM
  NOT_SURE
  REJECT
}

enum WorkflowActionType {
  INSPECT_TICKET
  ACCEPT_INSPECTION
  COMPLETE_INSPECTION
  REVIEW_INSPECTION
  CREATE_PROJECT
  ASSIGN_ENGINEER
  ACCEPT_PROJECT
  SET_TIMELINE
  START_WORK
  COMPLETE_WORK
  SUBMIT_COMPLETION
  RESPOND_DEPENDENCY
  FULFILL_DEPENDENCY
  REVIEW_GRIEVANCE
}

enum GrievanceSource {
  AUTO_NON_RESPONSE
  CITIZEN
}

enum GrievanceStatus {
  OPEN
  UNDER_REVIEW
  ESCALATED
  RESOLVED
  REOPENED
}

enum ReassignmentRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

enum ProjectBlockerStatus {
  OPEN
  RESOLVED
}

model User {
  id                   String                               @id @default(uuid()) @db.Uuid
  role                 UserRole
  phone                String?                              @unique
  email                String?                              @unique
  passwordHash         String?
  mustResetPassword    Boolean                              @default(false)
  phoneVerifiedAt      DateTime?
  totpSecret           String?
  totpEnabled          Boolean                              @default(false)
  deactivatedAt        DateTime?
  agencyId             String?                              @db.Uuid
  wardId               String?                              @db.Uuid
  lastKnownCoordinates Unsupported("geometry(Point,4326)")?
  createdAt            DateTime                             @default(now())

  agency                         Agency?                         @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  ward                           Ward?                           @relation(fields: [wardId], references: [id], onDelete: SetNull)
  reportedTickets                Ticket[]                        @relation("TicketReporter")
  observations                   Observation[]
  validations                    Validation[]
  validationRequests             ValidationRequest[]
  engineeringProjects            Project[]                       @relation("ProjectEngineer")
  ownedProjects                  Project[]                       @relation("ProjectOwner")
  createdProjects                Project[]                       @relation("ProjectCreator")
  updatedProjects                Project[]                       @relation("ProjectUpdater")
  assignedDependencies           Dependency[]                    @relation("DependencyEngineer")
  notifications                  Notification[]
  pushTokens                     PushToken[]
  otpChallenges                  OtpChallenge[]
  refreshSessions                RefreshSession[]
  submittedInspectionReports     InspectionReport[]              @relation("InspectionSubmitter")
  assignedInspections            InspectionReport[]              @relation("InspectionEngineer")
  inspectionAssignmentsCreated   InspectionReport[]              @relation("InspectionAssigner")
  reviewedInspections            InspectionReport[]              @relation("InspectionReviewer")
  inspectionEvidence             InspectionEvidence[]
  dependencyTransitions          DependencyStateTransition[]     @relation("DependencyTransitionActor")
  projectTransitions             ProjectStateTransition[]        @relation("ProjectTransitionActor")
  ticketTransitions              TicketStateTransition[]         @relation("TicketTransitionActor")
  projectWorkNotes               ProjectWorkNote[]
  projectEvidence                ProjectEvidence[]
  projectAuditEvents             ProjectAuditEvent[]
  completionEvidence             CompletionEvidence[]            @relation("CompletionEvidenceSubmitter")
  completionVerificationRequests CompletionVerificationRequest[]
  completionVerifications        CompletionVerification[]
  sequencingRecommendationLogs   SequencingRecommendationLog[]
  responsibleActions             WorkflowAction[]                @relation("WorkflowActionResponsibleUser")
  grievancesRaised               Grievance[]                     @relation("GrievanceRaisedBy")
  responsibleGrievances          Grievance[]                     @relation("GrievanceResponsibleUser")
  coordinationRequestsCreated    CoordinationRequest[]           @relation("CoordinationCreator")
  coordinationAssignments        CoordinationRequest[]           @relation("CoordinationEngineer")
  coordinationEntries            CoordinationEntry[]
  coordinationAttachments        CoordinationAttachment[]
  reassignmentRequests           ProjectReassignmentRequest[] @relation("ReassignmentRequester")
  reassignmentDecisions          ProjectReassignmentRequest[] @relation("ReassignmentDecider")
  reassignmentDestinations       ProjectReassignmentRequest[] @relation("ReassignmentNewEngineer")
  blockersReported               ProjectBlocker[]             @relation("BlockerReporter")
  blockersResolved               ProjectBlocker[]             @relation("BlockerResolver")

  @@index([agencyId])
  @@index([wardId])
  @@index([role])
  @@index([lastKnownCoordinates], type: Gist, map: "User_lastKnownCoordinates_gist_idx")
}

model Ward {
  id                               String                                @id @default(uuid()) @db.Uuid
  name                             String                                @unique
  boundary                         Unsupported("geometry(Polygon,4326)")
  verificationRadiusOverrideMeters Int?

  users        User[]
  tickets      Ticket[]
  roadSegments RoadSegment[]
  projects     Project[]
}

model Agency {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique
  type String

  users                  User[]
  primaryCategories      Category[]
  routingDependencies    RoutingRule[]
  assignedTickets        Ticket[]              @relation("TicketAssignedAgency")
  projects               Project[]
  requestedDependencies  Dependency[]          @relation("DependencyRequestingAgency")
  respondingDependencies Dependency[]          @relation("DependencyRespondingAgency")
  requestedInterventions Intervention[]
  projectConflictLogs    ConflictLog[]         @relation("ConflictLogProjectAgency")
  conflictingProjectLogs ConflictLog[]         @relation("ConflictLogConflictingAgency")
  roadConflictLogs       RoadConflictLog[]     @relation("RoadConflictProjectAgency")
  conflictingRoadLogs    RoadConflictLog[]     @relation("RoadConflictConflictingAgency")
  workflowActions        WorkflowAction[]
  grievances             Grievance[]
  requestedCoordinations CoordinationRequest[] @relation("CoordinationRequestingAgency")
  receivedCoordinations  CoordinationRequest[] @relation("CoordinationRespondingAgency")
  coordinationEntries    CoordinationEntry[]
}

model Category {
  id              String  @id @default(uuid()) @db.Uuid
  name            String  @unique
  relevancePrompt String
  primaryAgencyId String  @db.Uuid
  isConfigurable  Boolean @default(true)

  primaryAgency Agency        @relation(fields: [primaryAgencyId], references: [id], onDelete: Restrict)
  routingRules  RoutingRule[]
  tickets       Ticket[]
  projects      Project[]

  @@index([primaryAgencyId])
}

model RoutingRule {
  categoryId         String @db.Uuid
  dependencyAgencyId String @db.Uuid

  category         Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  dependencyAgency Agency   @relation(fields: [dependencyAgencyId], references: [id], onDelete: Cascade)

  @@id([categoryId, dependencyAgencyId])
  @@index([categoryId])
  @@index([dependencyAgencyId])
}

model Ticket {
  id                         String                              @id @default(uuid()) @db.Uuid
  referenceNumber            String                              @unique @default(dbgenerated("next_ticket_reference()")) @db.VarChar(20)
  categoryId                 String                              @db.Uuid
  reporterId                 String?                             @db.Uuid
  assignedAgencyId           String?                             @db.Uuid
  coordinates                Unsupported("geometry(Point,4326)")
  wardId                     String                              @db.Uuid
  roadSegmentId              String?                             @db.Uuid
  state                      TicketState                         @default(DRAFT)
  channel                    Channel                             @default(MOBILE)
  title                      String                              @default("Civic issue") @db.VarChar(160)
  address                    String                              @default("Location pending")
  aiRetryCount               Int                                 @default(0)
  manualReviewRecommended    Boolean                             @default(false)
  duplicateReviewRecommended Boolean                             @default(false)
  duplicateCandidateId       String?                             @db.Uuid
  duplicateVisualSimilarity  Float?
  duplicateVisualMatch       Boolean?
  createdAt                  DateTime                            @default(now())
  updatedAt                  DateTime                            @updatedAt

  category           Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reporter           User?                   @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assignedAgency     Agency?                 @relation("TicketAssignedAgency", fields: [assignedAgencyId], references: [id], onDelete: SetNull)
  ward               Ward                    @relation(fields: [wardId], references: [id], onDelete: Restrict)
  roadSegment        RoadSegment?            @relation(fields: [roadSegmentId], references: [id], onDelete: SetNull)
  observations       Observation[]
  validations        Validation[]
  validationRequests ValidationRequest[]
  project            Project?
  stateTransitions   TicketStateTransition[]
  inspectionReports  InspectionReport[]
  completionEvidence CompletionEvidence[]
  workflowActions    WorkflowAction[]
  grievances         Grievance[]

  @@index([categoryId])
  @@index([reporterId])
  @@index([assignedAgencyId])
  @@index([assignedAgencyId, createdAt])
  @@index([wardId])
  @@index([roadSegmentId])
  @@index([state])
  @@index([coordinates], type: Gist, map: "Ticket_coordinates_gist_idx")
}

model TicketReferenceCounter {
  period    String @id @db.VarChar(6)
  lastValue Int
}

model InspectionReport {
  id                     String                      @id @default(uuid()) @db.Uuid
  ticketId               String                      @db.Uuid
  assignedEngineerId     String                      @db.Uuid
  assignedById           String                      @db.Uuid
  submittedById          String?                     @db.Uuid
  reviewedById           String?                     @db.Uuid
  status                 InspectionStatus            @default(ASSIGNED)
  deadline               DateTime
  acceptedAt             DateTime?
  startedAt              DateTime?
  submittedAt            DateTime?
  reviewedAt             DateTime?
  issueConfirmation      InspectionIssueConfirmation?
  severity               InspectionSeverity?
  observations           String?
  recommendedWork        String?
  complexity             InspectionComplexity?
  coordinationRequired   Boolean?
  otherAgencyInvolvement String?
  recommendation         InspectionRecommendation?
  latitude               Float?
  longitude              Float?
  locationConfirmedAt    DateTime?
  reviewDecision         InspectionReviewDecision?
  reviewNote             String?
  fileUrl                String?
  objectKey              String?                     @unique
  contentType            String?
  notes                  String?
  uploadedAt             DateTime?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  ticket           Ticket               @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignedEngineer User                 @relation("InspectionEngineer", fields: [assignedEngineerId], references: [id], onDelete: Restrict)
  assignedBy       User                 @relation("InspectionAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  submittedBy      User?                @relation("InspectionSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy       User?                @relation("InspectionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  evidence         InspectionEvidence[]

  @@index([ticketId, createdAt])
  @@index([assignedEngineerId, status, deadline])
  @@index([assignedById])
  @@index([submittedById])
  @@index([reviewedById])
}

model InspectionEvidence {
  id           String    @id @default(uuid()) @db.Uuid
  inspectionId String    @db.Uuid
  uploadedById String    @db.Uuid
  fileUrl      String
  objectKey    String    @unique
  contentType  String
  uploadedAt   DateTime?
  createdAt    DateTime  @default(now())

  inspection InspectionReport @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  uploadedBy User             @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([inspectionId, createdAt])
  @@index([uploadedById])
}

model Observation {
  id          String   @id @default(uuid()) @db.Uuid
  ticketId    String   @db.Uuid
  submitterId String   @db.Uuid
  imageUrl    String
  note        String?
  latitude    Float?
  longitude   Float?
  address     String?
  createdAt   DateTime @default(now())

  ticket    Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  submitter User    @relation(fields: [submitterId], references: [id], onDelete: Restrict)
  images    Image[]

  @@index([ticketId])
  @@index([submitterId])
}

model Image {
  id               String    @id @default(uuid()) @db.Uuid
  observationId    String    @db.Uuid
  url              String
  objectKey        String    @unique
  contentType      String?
  isPrimary        Boolean   @default(false)
  aiRelevanceScore Float?
  embedding        Json?
  uploadedAt       DateTime?
  createdAt        DateTime  @default(now())

  observation Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@index([observationId])
  @@index([observationId, isPrimary])
}

model TicketStateTransition {
  id        String       @id @default(uuid()) @db.Uuid
  ticketId  String       @db.Uuid
  fromState TicketState?
  toState   TicketState
  reason    String
  actedById String?      @db.Uuid
  createdAt DateTime     @default(now())

  ticket  Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actedBy User?  @relation("TicketTransitionActor", fields: [actedById], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([actedById])
}

model Validation {
  id          String         @id @default(uuid()) @db.Uuid
  ticketId    String         @db.Uuid
  validatorId String         @db.Uuid
  vote        ValidationVote
  counted     Boolean        @default(true)
  createdAt   DateTime       @default(now())

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  validator User   @relation(fields: [validatorId], references: [id], onDelete: Restrict)

  @@unique([ticketId, validatorId])
  @@index([ticketId])
  @@index([validatorId])
  @@index([validatorId, createdAt])
}

model ValidationRequest {
  id             String    @id @default(uuid()) @db.Uuid
  ticketId       String    @db.Uuid
  citizenId      String    @db.Uuid
  batchNumber    Int
  distanceMeters Float
  notifiedAt     DateTime  @default(now())
  expiresAt      DateTime
  respondedAt    DateTime?

  ticket  Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  citizen User   @relation(fields: [citizenId], references: [id], onDelete: Cascade)

  @@unique([ticketId, citizenId])
  @@index([ticketId, batchNumber])
  @@index([citizenId, expiresAt])
  @@index([expiresAt])
}

model Project {
  id                 String                                  @id @default(uuid()) @db.Uuid
  referenceNumber    String                                  @unique @default(dbgenerated("next_civic_work_reference()")) @db.VarChar(24)
  ticketId           String?                                 @unique @db.Uuid
  categoryId         String?                                 @db.Uuid
  agencyId           String                                  @db.Uuid
  ownerProjectHeadId String?                                 @db.Uuid
  createdById        String?                                 @db.Uuid
  updatedById        String?                                 @db.Uuid
  origin             CivicWorkOrigin                         @default(CITIZEN_REPORTED)
  title              String                                  @default("Civic work") @db.VarChar(180)
  description        String?
  locationLabel      String?
  geometry           Unsupported("geometry(Geometry,4326)")?
  wardId             String?                                 @db.Uuid
  state              ProjectState                            @default(CREATED)
  priority           CivicWorkPriority                       @default(NORMAL)
  plannedStart       DateTime?
  plannedEnd         DateTime?
  actualStart        DateTime?
  actualCompletion   DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  workDescription    String?
  dependencyFlags    Json                                    @default("[]")
  engineerId         String?                                 @db.Uuid
  createdAt          DateTime                                @default(now())
  updatedAt          DateTime                                @updatedAt

  ticket               Ticket?                  @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  category             Category?                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  agency               Agency                   @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  ward                 Ward?                    @relation(fields: [wardId], references: [id], onDelete: Restrict)
  ownerProjectHead     User?                    @relation("ProjectOwner", fields: [ownerProjectHeadId], references: [id], onDelete: SetNull)
  createdBy            User?                    @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy            User?                    @relation("ProjectUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  engineer             User?                    @relation("ProjectEngineer", fields: [engineerId], references: [id], onDelete: SetNull)
  dependencies         Dependency[]
  intervention         Intervention?
  stateTransitions     ProjectStateTransition[]
  workNotes            ProjectWorkNote[]
  evidence             ProjectEvidence[]
  auditEvents          ProjectAuditEvent[]
  completionEvidence   CompletionEvidence[]
  conflictLogs         ConflictLog[]            @relation("ConflictLogProject")
  conflictingLogs      ConflictLog[]            @relation("ConflictLogConflictingProject")
  roadConflictLogs     RoadConflictLog[]        @relation("RoadConflictProject")
  conflictingRoadLogs  RoadConflictLog[]        @relation("RoadConflictConflictingProject")
  workflowActions      WorkflowAction[]
  grievances           Grievance[]
  coordinationRequests CoordinationRequest[]
  conflictingCoordinationRequests CoordinationRequest[] @relation("CoordinationConflictingProject")
  reassignmentRequests ProjectReassignmentRequest[]
  blockers             ProjectBlocker[]

  @@index([ticketId])
  @@index([categoryId])
  @@index([agencyId])
  @@index([wardId])
  @@index([ownerProjectHeadId])
  @@index([createdById])
  @@index([engineerId])
  @@index([state])
  @@index([origin])
  @@index([priority])
  @@index([plannedStart, plannedEnd])
  @@index([agencyId, createdAt])
  @@index([engineerId, state, createdAt])
  @@index([geometry], type: Gist, map: "Project_geometry_gist_idx")
}

model ProjectReassignmentRequest {
  id             String                    @id @default(uuid()) @db.Uuid
  projectId      String                    @db.Uuid
  requestedById  String                    @db.Uuid
  decidedById    String?                   @db.Uuid
  newEngineerId  String?                   @db.Uuid
  reason         String                    @db.VarChar(80)
  note           String?
  availableFrom  DateTime?
  status         ReassignmentRequestStatus @default(PENDING)
  decisionNote   String?
  decidedAt      DateTime?
  createdAt      DateTime                  @default(now())

  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy  User    @relation("ReassignmentRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy    User?   @relation("ReassignmentDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  newEngineer  User?   @relation("ReassignmentNewEngineer", fields: [newEngineerId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([requestedById, createdAt])
}

model ProjectBlocker {
  id           String               @id @default(uuid()) @db.Uuid
  projectId    String               @db.Uuid
  reportedById String               @db.Uuid
  resolvedById String?              @db.Uuid
  title        String               @db.VarChar(180)
  details      String
  severity     String               @db.VarChar(20)
  status       ProjectBlockerStatus @default(OPEN)
  resolution   String?
  resolvedAt   DateTime?
  createdAt    DateTime             @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportedBy User    @relation("BlockerReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  resolvedBy User?   @relation("BlockerResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([status, createdAt])
}

model CivicWorkReferenceCounter {
  period    String @id @db.VarChar(6)
  lastValue Int
}

model ConflictLog {
  id                       String           @id @default(uuid()) @db.Uuid
  projectId                String           @db.Uuid
  conflictingProjectId     String           @db.Uuid
  projectAgencyId          String           @db.Uuid
  conflictingAgencyId      String           @db.Uuid
  projectTimelineStart     DateTime
  projectTimelineEnd       DateTime
  conflictingTimelineStart DateTime
  conflictingTimelineEnd   DateTime
  overlapStart             DateTime
  overlapEnd               DateTime
  locationDescription      String
  distanceMeters           Float?
  severity                 ConflictSeverity
  timelineFingerprint      String           @db.Char(64)
  createdAt                DateTime         @default(now())

  project            Project @relation("ConflictLogProject", fields: [projectId], references: [id], onDelete: Cascade)
  conflictingProject Project @relation("ConflictLogConflictingProject", fields: [conflictingProjectId], references: [id], onDelete: Cascade)
  projectAgency      Agency  @relation("ConflictLogProjectAgency", fields: [projectAgencyId], references: [id], onDelete: Restrict)
  conflictingAgency  Agency  @relation("ConflictLogConflictingAgency", fields: [conflictingAgencyId], references: [id], onDelete: Restrict)
  coordinationRequests CoordinationRequest[]

  @@unique([projectId, conflictingProjectId, timelineFingerprint], map: "ConflictLog_pair_timeline_key")
  @@index([projectId, createdAt])
  @@index([conflictingProjectId, createdAt])
  @@index([conflictingAgencyId])
}

model ProjectStateTransition {
  id        String        @id @default(uuid()) @db.Uuid
  projectId String        @db.Uuid
  fromState ProjectState?
  toState   ProjectState
  reason    String
  actedById String?       @db.Uuid
  createdAt DateTime      @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actedBy User?   @relation("ProjectTransitionActor", fields: [actedById], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([actedById])
}

model ProjectWorkNote {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  authorId  String   @db.Uuid
  note      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([authorId])
}

model ProjectEvidence {
  id          String              @id @default(uuid()) @db.Uuid
  projectId   String              @db.Uuid
  kind        ProjectEvidenceKind
  label       String
  url         String
  objectKey   String?             @unique
  contentType String?
  createdById String              @db.Uuid
  uploadedAt  DateTime?
  createdAt   DateTime            @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([createdById])
}

model ProjectAuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  action    String   @db.VarChar(80)
  actorId   String?  @db.Uuid
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([actorId])
}

model CompletionEvidence {
  id            String    @id @default(uuid()) @db.Uuid
  projectId     String    @db.Uuid
  ticketId      String    @db.Uuid
  submittedById String    @db.Uuid
  photoUrl      String
  objectKey     String    @unique
  contentType   String
  notes         String
  uploadedAt    DateTime?
  createdAt     DateTime  @default(now())

  project              Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ticket               Ticket                          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  submittedBy          User                            @relation("CompletionEvidenceSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  verificationRequests CompletionVerificationRequest[]
  verifications        CompletionVerification[]

  @@index([projectId, createdAt])
  @@index([ticketId])
  @@index([submittedById])
}

model CompletionVerificationRequest {
  id                   String    @id @default(uuid()) @db.Uuid
  completionEvidenceId String    @db.Uuid
  citizenId            String    @db.Uuid
  notifiedAt           DateTime  @default(now())
  respondedAt          DateTime?

  completionEvidence CompletionEvidence @relation(fields: [completionEvidenceId], references: [id], onDelete: Cascade)
  citizen            User               @relation(fields: [citizenId], references: [id], onDelete: Cascade)

  @@unique([completionEvidenceId, citizenId])
  @@index([citizenId, respondedAt])
}

model CompletionVerification {
  id                   String                         @id @default(uuid()) @db.Uuid
  completionEvidenceId String                         @db.Uuid
  validatorId          String                         @db.Uuid
  decision             CompletionVerificationDecision
  note                 String?
  createdAt            DateTime                       @default(now())

  completionEvidence CompletionEvidence @relation(fields: [completionEvidenceId], references: [id], onDelete: Cascade)
  validator          User               @relation(fields: [validatorId], references: [id], onDelete: Restrict)

  @@unique([completionEvidenceId, validatorId])
  @@index([validatorId, createdAt])
}

model Dependency {
  id                 String          @id @default(uuid()) @db.Uuid
  projectId          String          @db.Uuid
  requestingAgencyId String          @db.Uuid
  respondingAgencyId String          @db.Uuid
  assignedEngineerId String?         @db.Uuid
  state              DependencyState @default(REQUESTED)
  requirement        String
  deadline           DateTime
  respondedAt        DateTime?
  escalatedAt        DateTime?
  deadlineReminderSentAt DateTime?
  createdAt          DateTime        @default(now())

  project              Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestingAgency     Agency                      @relation("DependencyRequestingAgency", fields: [requestingAgencyId], references: [id], onDelete: Restrict)
  respondingAgency     Agency                      @relation("DependencyRespondingAgency", fields: [respondingAgencyId], references: [id], onDelete: Restrict)
  assignedEngineer     User?                       @relation("DependencyEngineer", fields: [assignedEngineerId], references: [id], onDelete: SetNull)
  stateTransitions     DependencyStateTransition[]
  workflowActions      WorkflowAction[]
  grievances           Grievance[]
  coordinationRequests CoordinationRequest[]

  @@unique([projectId, respondingAgencyId])
  @@index([projectId])
  @@index([requestingAgencyId])
  @@index([respondingAgencyId])
  @@index([assignedEngineerId])
  @@index([state])
  @@index([state, deadline])
}

model CoordinationRequest {
  id                    String             @id @default(uuid()) @db.Uuid
  projectId             String             @db.Uuid
  dependencyId          String?            @db.Uuid
  conflictLogId         String?            @db.Uuid
  roadConflictLogId     String?            @db.Uuid
  conflictingProjectId  String?            @db.Uuid
  requestingAgencyId    String             @db.Uuid
  respondingAgencyId    String             @db.Uuid
  createdById           String             @db.Uuid
  assignedEngineerId    String?            @db.Uuid
  requestTypeKey        String             @db.VarChar(80)
  subject               String             @db.VarChar(180)
  details               String
  responseDeadline      DateTime
  inspectionNeeded      Boolean            @default(false)
  engineerRequired      Boolean            @default(false)
  proposedAt            DateTime?
  inspectionCompletedAt DateTime?
  status                CoordinationStatus @default(DRAFT)
  sentAt                DateTime?
  closedAt              DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  project          Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conflictingProject Project?               @relation("CoordinationConflictingProject", fields: [conflictingProjectId], references: [id], onDelete: SetNull)
  dependency       Dependency?              @relation(fields: [dependencyId], references: [id], onDelete: SetNull)
  conflictLog      ConflictLog?             @relation(fields: [conflictLogId], references: [id], onDelete: SetNull)
  roadConflictLog  RoadConflictLog?         @relation(fields: [roadConflictLogId], references: [id], onDelete: SetNull)
  requestingAgency Agency                   @relation("CoordinationRequestingAgency", fields: [requestingAgencyId], references: [id], onDelete: Restrict)
  respondingAgency Agency                   @relation("CoordinationRespondingAgency", fields: [respondingAgencyId], references: [id], onDelete: Restrict)
  createdBy        User                     @relation("CoordinationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedEngineer User?                    @relation("CoordinationEngineer", fields: [assignedEngineerId], references: [id], onDelete: SetNull)
  entries          CoordinationEntry[]
  attachments      CoordinationAttachment[]

  @@index([projectId, createdAt])
  @@index([dependencyId])
  @@index([conflictLogId])
  @@index([roadConflictLogId])
  @@index([conflictingProjectId])
  @@index([requestingAgencyId, status, responseDeadline], map: "CoordinationRequest_requestingAgencyId_status_responseDeadline_")
  @@index([respondingAgencyId, status, responseDeadline], map: "CoordinationRequest_respondingAgencyId_status_responseDeadline_")
  @@index([assignedEngineerId, status])
}

model CoordinationEntry {
  id             String              @id @default(uuid()) @db.Uuid
  requestId      String              @db.Uuid
  senderId       String              @db.Uuid
  senderAgencyId String              @db.Uuid
  action         String              @db.VarChar(80)
  message        String?
  fromStatus     CoordinationStatus?
  toStatus       CoordinationStatus?
  createdAt      DateTime            @default(now())

  request      CoordinationRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender       User                     @relation(fields: [senderId], references: [id], onDelete: Restrict)
  senderAgency Agency                   @relation(fields: [senderAgencyId], references: [id], onDelete: Restrict)
  attachments  CoordinationAttachment[]

  @@index([requestId, createdAt])
  @@index([senderId])
}

model CoordinationAttachment {
  id           String    @id @default(uuid()) @db.Uuid
  requestId    String    @db.Uuid
  entryId      String    @db.Uuid
  uploadedById String    @db.Uuid
  fileName     String    @db.VarChar(200)
  objectKey    String    @unique
  contentType  String    @db.VarChar(100)
  sizeBytes    Int?
  uploadedAt   DateTime?
  createdAt    DateTime  @default(now())

  request    CoordinationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  entry      CoordinationEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  uploadedBy User                @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([entryId])
  @@index([uploadedById])
}

model DependencyStateTransition {
  id           String           @id @default(uuid()) @db.Uuid
  dependencyId String           @db.Uuid
  fromState    DependencyState?
  toState      DependencyState
  reason       String
  actedById    String?          @db.Uuid
  createdAt    DateTime         @default(now())

  dependency Dependency @relation(fields: [dependencyId], references: [id], onDelete: Cascade)
  actedBy    User?      @relation("DependencyTransitionActor", fields: [actedById], references: [id], onDelete: SetNull)

  @@index([dependencyId, createdAt])
  @@index([actedById])
}

model RoadSegment {
  id                  String                                   @id @default(uuid()) @db.Uuid
  roadName            String
  geometry            Unsupported("geometry(LineString,4326)")
  wardId              String                                   @db.Uuid
  surfaceType         String
  lastRestorationDate DateTime?

  ward                         Ward                          @relation(fields: [wardId], references: [id], onDelete: Restrict)
  interventions                Intervention[]
  tickets                      Ticket[]
  roadConflictLogs             RoadConflictLog[]
  sequencingRecommendations    SequencingRecommendation[]
  sequencingRecommendationLogs SequencingRecommendationLog[]

  @@index([wardId])
  @@index([roadName])
  @@index([geometry], type: Gist, map: "RoadSegment_geometry_gist_idx")
}

model Intervention {
  id                 String   @id @default(uuid()) @db.Uuid
  projectId          String   @unique @db.Uuid
  segmentId          String   @db.Uuid
  requestingAgencyId String   @db.Uuid
  purpose            String
  plannedStart       DateTime
  plannedEnd         DateTime
  affectedLengthM    Float
  startOffsetM       Float    @default(0)
  dependencyRefs     Json     @default("[]")
  createdAt          DateTime @default(now())

  project          Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  segment          RoadSegment @relation(fields: [segmentId], references: [id], onDelete: Restrict)
  requestingAgency Agency      @relation(fields: [requestingAgencyId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([segmentId])
  @@index([requestingAgencyId])
}

model RoadConflictLog {
  id                   String               @id @default(uuid()) @db.Uuid
  projectId            String               @db.Uuid
  conflictingProjectId String?              @db.Uuid
  segmentId            String               @db.Uuid
  projectAgencyId      String               @db.Uuid
  conflictingAgencyId  String?              @db.Uuid
  type                 RoadConflictType
  severity             RoadConflictSeverity
  reason               String
  fingerprint          String               @db.Char(64)
  createdAt            DateTime             @default(now())

  project            Project     @relation("RoadConflictProject", fields: [projectId], references: [id], onDelete: Cascade)
  conflictingProject Project?    @relation("RoadConflictConflictingProject", fields: [conflictingProjectId], references: [id], onDelete: Cascade)
  segment            RoadSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  projectAgency      Agency      @relation("RoadConflictProjectAgency", fields: [projectAgencyId], references: [id], onDelete: Restrict)
  conflictingAgency  Agency?     @relation("RoadConflictConflictingAgency", fields: [conflictingAgencyId], references: [id], onDelete: Restrict)
  coordinationRequests CoordinationRequest[]

  @@unique([projectId, type, fingerprint])
  @@index([projectId, createdAt])
  @@index([conflictingProjectId, createdAt])
  @@index([segmentId, createdAt])
}

model SequencingRecommendation {
  id            String   @id @default(uuid()) @db.Uuid
  segmentId     String   @db.Uuid
  projectIds    Json
  proposedOrder Json
  explanation   String
  ruleTrace     Json
  fingerprint   String   @unique @db.Char(64)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  segment RoadSegment                   @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  logs    SequencingRecommendationLog[]

  @@index([segmentId, updatedAt])
}

model SequencingRecommendationLog {
  id               String                          @id @default(uuid()) @db.Uuid
  recommendationId String                          @db.Uuid
  segmentId        String                          @db.Uuid
  proposedOrder    Json
  outcome          SequencingRecommendationOutcome
  actedById        String                          @db.Uuid
  actedAt          DateTime                        @default(now())

  recommendation SequencingRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  segment        RoadSegment              @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  actedBy        User                     @relation(fields: [actedById], references: [id], onDelete: Restrict)

  @@index([recommendationId, actedAt])
  @@index([segmentId, actedAt])
  @@index([actedById])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String
  payload   Json
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushDeliveries NotificationPushDelivery[]

  @@index([userId])
  @@index([userId, read])
  @@index([userId, read, createdAt])
}

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  platform  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationPushDelivery[]

  @@index([userId, active])
}

model NotificationPushDelivery {
  id             String    @id @default(uuid()) @db.Uuid
  notificationId String    @db.Uuid
  pushTokenId    String    @db.Uuid
  status         String    @default("PENDING")
  attemptCount   Int       @default(0)
  receiptId      String?
  lastError      String?
  lastAttemptAt  DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  pushToken    PushToken    @relation(fields: [pushTokenId], references: [id], onDelete: Cascade)

  @@unique([notificationId, pushTokenId])
  @@index([status, createdAt])
}

model WorkflowAction {
  id                  String             @id @default(uuid()) @db.Uuid
  dedupeKey           String             @unique @db.VarChar(220)
  type                WorkflowActionType
  ticketId            String             @db.Uuid
  projectId           String?            @db.Uuid
  dependencyId        String?            @db.Uuid
  responsibleUserId   String             @db.Uuid
  responsibleAgencyId String             @db.Uuid
  deadline            DateTime
  respondedAt         DateTime?
  attentionNotifiedAt DateTime?
  createdAt           DateTime           @default(now())

  ticket            Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  project           Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dependency        Dependency? @relation(fields: [dependencyId], references: [id], onDelete: Cascade)
  responsibleUser   User        @relation("WorkflowActionResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  responsibleAgency Agency      @relation(fields: [responsibleAgencyId], references: [id], onDelete: Restrict)
  grievance         Grievance?

  @@index([responsibleUserId, respondedAt, deadline])
  @@index([responsibleAgencyId, respondedAt, deadline])
  @@index([ticketId])
  @@index([projectId])
  @@index([dependencyId])
}

model Grievance {
  id                  String          @id @default(uuid()) @db.Uuid
  ticketId            String          @db.Uuid
  projectId           String?         @db.Uuid
  dependencyId        String?         @db.Uuid
  actionId            String?         @unique @db.Uuid
  raisedByUserId      String?         @db.Uuid
  responsibleUserId   String?         @db.Uuid
  responsibleAgencyId String          @db.Uuid
  reason              String
  note                String?
  evidenceUrl         String?
  evidenceObjectKey   String?         @unique
  evidenceContentType String?
  evidenceUploadedAt  DateTime?
  source              GrievanceSource
  status              GrievanceStatus @default(OPEN)
  createdAt           DateTime        @default(now())
  escalatedAt         DateTime?
  resolvedAt          DateTime?
  resolutionNote      String?

  ticket            Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  project           Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  dependency        Dependency?     @relation(fields: [dependencyId], references: [id], onDelete: SetNull)
  action            WorkflowAction? @relation(fields: [actionId], references: [id], onDelete: SetNull)
  raisedByUser      User?           @relation("GrievanceRaisedBy", fields: [raisedByUserId], references: [id], onDelete: SetNull)
  responsibleUser   User?           @relation("GrievanceResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  responsibleAgency Agency          @relation(fields: [responsibleAgencyId], references: [id], onDelete: Restrict)

  @@index([ticketId, status, createdAt])
  @@index([projectId, status])
  @@index([dependencyId, status])
  @@index([responsibleAgencyId, status, createdAt])
  @@index([responsibleUserId, status, createdAt])
  @@index([raisedByUserId, createdAt])
}

model SystemConfig {
  key         String @id
  value       Json
  description String
}

model OtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
